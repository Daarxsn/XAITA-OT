# XAITA-OT V5 deployment configuration. Never commit real secrets.
XAITA_ENV=development

# Authentication / RBAC
# In staging/production authentication is required automatically.
# Legacy single-key mode: XAITA_API_KEY=change-me and optional role.
XAITA_API_KEY=
XAITA_API_KEY_ROLE=admin
# Preferred multi-role mode (JSON object; use a secrets manager in production).
# XAITA_API_KEYS_JSON={"viewer":"...","analyst":"...","admin":"..."}
XAITA_REQUIRE_AUTH=false

# Network hardening
XAITA_FORCE_HTTPS=false
XAITA_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated trusted browser origins. Empty disables CORS middleware.
XAITA_CORS_ORIGINS=
XAITA_ENABLE_DOCS=true

# Resource protection
XAITA_MAX_EVENTS=5000
XAITA_RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO

# Optional dataset mounts
# XAITA_SWAT_PATH=C:\data\swat
# XAITA_BATADAL_PATH=C:\data\batadal
# XAITA_TONIOT_PATH=C:\data\ton_iot
